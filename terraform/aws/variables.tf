variable "project_id" {
  description = "Unused on EKS; accepted so the root can pass the same arguments as for ./gcp."
  type        = string
  default     = ""
}

variable "region" {
  description = "AWS region for the EKS cluster"
  type        = string
}

variable "cluster" {
  description = "EKS cluster name"
  type        = string
}

variable "eks_version" {
  description = "Kubernetes version of the EKS cluster. Upgrade one minor version at a time."
  type        = string
  default     = "1.37"
}

variable "helm_namespace" {
  description = "Namespace of the Fabricate Helm release (used to scope the IRSA trust policy)"
  type        = string
}

variable "helm_release" {
  description = "Helm release name (used to derive the service account name for IRSA trust policy)"
  type        = string
}

variable "eks_instance_type" {
  description = "EC2 instance type EKS Auto Mode provisions for the Fabricate pods (pinned with a node selector). Use a Graviton type; the default has 2 vCPU and 8 GiB."
  type        = string
  default     = "t4g.large"
}

variable "eks_nodes_count" {
  description = "Maximum number of Fabricate nodes Auto Mode may provision (the pod co-location rule keeps all pods on one node, so 1 is the supported value)."
  type        = number
  default     = 1
}

variable "eks_node_vcpus" {
  description = "vCPUs of eks_instance_type (t4g.large = 2). Together with eks_nodes_count this sets the NodePool cpu limit."
  type        = number
  default     = 2
}

variable "vpc_id" {
  description = "VPC for the cluster, RDS and ElastiCache. Empty (default) uses the account's default VPC."
  type        = string
  default     = ""
}

variable "vpc_subnet_ids" {
  description = "Subnets (in at least two AZs) for the cluster, RDS and ElastiCache. Empty (default) picks two automatically from the VPC, skipping AZs EKS does not support. Nodes get public IPs only if the subnets auto-assign them (true for default VPC subnets)."
  type        = list(string)
  default     = []
}

variable "bedrock_api_key_age_days" {
  description = "Days until the generated Bedrock API key expires (1-36600). Terraform does not rotate it automatically: after it expires, run terraform apply -replace='module.cluster.aws_iam_service_specific_credential.bedrock[0]'."
  type        = number
  default     = 730
}

variable "bedrock_inference_prefix" {
  description = "Prefix for Bedrock cross-region inference profile model IDs (FABRICATE_BEDROCK_REGION), e.g. us -> us.anthropic.claude-*. Empty derives it from the region (us-* -> us, eu-* -> eu, ap-* -> apac, otherwise global). Use global for global inference profiles."
  type        = string
  default     = ""
}

variable "tags" {
  description = "Additional tags (AWS) / labels (GCP) applied to all resources created by the cloud module, merged over the built-in Project/ManagedBy defaults. On GCP, keys and values must be lowercase letters, digits, underscores or dashes."
  type        = map(string)
  default     = {}
}

variable "database_password" {
  description = "Master password for the RDS PostgreSQL instance (generated by the root module)."
  type        = string
  sensitive   = true
}

variable "redis_password" {
  description = "AUTH token for the ElastiCache Redis replication group, 16-128 chars (generated by the root module)."
  type        = string
  sensitive   = true
}

variable "rds_engine_version" {
  description = "PostgreSQL major (or full) version for RDS."
  type        = string
  default     = "16"
}

variable "rds_instance_class" {
  description = "RDS instance class (Graviton: db.t4g.*, db.m7g.*)."
  type        = string
  default     = "db.t4g.small"
}

variable "rds_allocated_storage" {
  description = "Initial RDS storage in GiB."
  type        = number
  default     = 20
}

variable "rds_max_allocated_storage" {
  description = "RDS storage autoscaling ceiling in GiB (0 disables autoscaling)."
  type        = number
  default     = 0
}

variable "rds_multi_az" {
  description = "Run RDS as a Multi-AZ deployment."
  type        = bool
  default     = false
}

variable "rds_backup_retention_days" {
  description = "Days to keep automated RDS backups (0 disables backups)."
  type        = number
  default     = 1
}

variable "rds_deletion_protection" {
  description = "Enable RDS deletion protection."
  type        = bool
  default     = false
}

variable "elasticache_node_type" {
  description = "ElastiCache node type (Graviton: cache.t4g.*, cache.m7g.*)."
  type        = string
  default     = "cache.t4g.micro"
}

variable "elasticache_engine_version" {
  description = "ElastiCache Redis engine version."
  type        = string
  default     = "7.1"
}

variable "s3_force_destroy" {
  description = "Empty the Active Storage S3 bucket (all objects) on terraform destroy so deleting it does not fail with BucketNotEmpty. Set false to keep a safety net that makes destroy fail while the bucket holds data."
  type        = bool
  default     = true
}

variable "enable_cloudwatch_logs" {
  description = "Send EKS control plane logs, RDS PostgreSQL logs, ElastiCache Redis slow/engine logs and pod logs (Fluent Bit) to CloudWatch Logs."
  type        = bool
  default     = true
}

variable "cloudwatch_log_retention_days" {
  description = "Retention in days applied to every CloudWatch log group created by this module (EKS, application pods, RDS, ElastiCache). Must be a value CloudWatch Logs accepts."
  type        = number
  default     = 30

  validation {
    condition     = contains([1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 2192, 2557, 2922, 3288, 3653], var.cloudwatch_log_retention_days)
    error_message = "cloudwatch_log_retention_days must be one of the retention values CloudWatch Logs supports (1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 2192, 2557, 2922, 3288, 3653)."
  }
}

variable "name_prefix" {
  description = "Chart naming prefix <app>-<environment> (e.g. fabricate-prod), used for the app service account and the NodePool."
  type        = string
  default     = "fabricate-prod"
}

variable "enable_https" {
  description = "Open an HTTPS listener (443) on the ALB with HTTP -> HTTPS redirect, and set FABRICATE_PROTOCOL=https. The certificate is var.https_cert_arn when set, otherwise a self-signed one generated on the first apply."
  type        = bool
  default     = true
}

variable "https_cert_arn" {
  description = "ARN of an ACM certificate (same region) for the ALB HTTPS listener. Empty (default) generates a self-signed certificate on the first apply."
  type        = string
  default     = ""
}

variable "enable_ses" {
  description = "Set up Amazon SES for outgoing email: a verified sender address (ses_email) and an IAM SMTP user, wired into FABRICATE_MAIL_*. Has no effect while ses_email is empty."
  type        = bool
  default     = true
}

variable "ses_email" {
  description = "Sender address to verify in SES; also used as FABRICATE_MAIL_FROM. SES is only set up while this is non-empty."
  type        = string
  default     = ""
}

variable "enable_bedrock" {
  description = "Set up Amazon Bedrock as the AI provider: an IAM user with a Bedrock API key (FABRICATE_BEDROCK_API_KEY), the model prefix (FABRICATE_BEDROCK_REGION) and Bedrock access for the app role."
  type        = bool
  default     = true
}

variable "enable_rds" {
  description = "Use Amazon RDS for PostgreSQL. When false no RDS is created and the chart runs PostgreSQL inside the cluster (StatefulSet with an EBS volume on the Fabricate node)."
  type        = bool
  default     = true
}

variable "enable_elasticache" {
  description = "Use Amazon ElastiCache for Redis. When false no ElastiCache is created and the chart runs Redis inside the cluster (StatefulSet)."
  type        = bool
  default     = true
}

variable "enable_alb" {
  description = "Use the EKS Auto Mode ALB as the ingress controller (AWS only): Terraform sets up the IngressClass, the HTTPS listener and the certificate. Set false to use a different ingress controller (for example nginx) that you install yourself; the Ingress is then configured under ingress.* in values.yaml."
  type        = bool
  default     = true
}

variable "eks_public_access_cidrs" {
  description = "CIDR blocks allowed to reach the public EKS API endpoint (kubectl, Terraform's Helm and kubectl steps). The default allows the whole internet; restrict it to your office / CI addresses, for example [\"203.0.113.10/32\"]. Nodes and pods always use the private endpoint, so restricting this does not affect the cluster itself."
  type        = list(string)
  default     = ["0.0.0.0/0"]

  validation {
    condition     = length(var.eks_public_access_cidrs) > 0
    error_message = "eks_public_access_cidrs must contain at least one CIDR."
  }
}

variable "eks_secrets_encryption" {
  description = "Encrypt Kubernetes Secrets in the EKS control plane with a customer managed KMS key (envelope encryption, key rotation on). Can be turned on later but not off again for an existing cluster."
  type        = bool
  default     = true
}

variable "project_id" {
  description = "Unused on EKS; accepted so the root can pass the same arguments as for ./gcp."
  type        = string
  default     = ""
}

variable "region" {
  description = "AWS region for the EKS cluster"
  type        = string
}

variable "kube_cluster" {
  description = "EKS cluster name"
  type        = string
}

variable "kube_helm_namespace" {
  description = "Namespace of the Fabricate Helm release (used to scope the IRSA trust policy)"
  type        = string
}

variable "kube_helm_release" {
  description = "Helm release name (used to derive the service account name for IRSA trust policy)"
  type        = string
}

variable "eks_instance_type" {
  description = "EC2 instance type EKS Auto Mode provisions for the Fabricate pods (pinned with a node selector). Use a Graviton type; the default has 2 vCPU and 8 GiB."
  type        = string
  default     = "t4g.large"
}

variable "eks_node_count" {
  description = "Maximum number of Fabricate nodes Auto Mode may provision (the pod co-location rule keeps all pods on one node, so 1 is the supported value)."
  type        = number
  default     = 1
}

variable "eks_node_vcpus" {
  description = "vCPUs of eks_instance_type (t4g.large = 2). Together with eks_node_count this sets the NodePool cpu limit."
  type        = number
  default     = 2
}

variable "kube_vpc_id" {
  description = "VPC for the cluster, RDS and ElastiCache. Empty (default) uses the account's default VPC."
  type        = string
  default     = ""
}

variable "kube_subnet_ids" {
  description = "Subnets (in at least two AZs) for the cluster, RDS and ElastiCache. Empty (default) picks two automatically from the VPC, skipping AZs EKS does not support. Nodes get public IPs only if the subnets auto-assign them (true for default VPC subnets)."
  type        = list(string)
  default     = []
}

variable "bedrock_api_key_age_days" {
  description = "Days until the generated Bedrock API key expires (1-36600). Terraform does not rotate it automatically: after it expires, run terraform apply -replace='module.cluster.aws_iam_service_specific_credential.bedrock'."
  type        = number
  default     = 365
}

variable "bedrock_inference_prefix" {
  description = "Prefix for Bedrock cross-region inference profile model IDs (FABRICATE_BEDROCK_REGION), e.g. us -> us.anthropic.claude-*. Empty derives it from the region (us-* -> us, eu-* -> eu, ap-* -> apac, otherwise global). Use global for global inference profiles."
  type        = string
  default     = ""
}

variable "tags" {
  description = "Additional tags (AWS) / labels (GCP) applied to all resources created by the cloud module, merged over the built-in Project/ManagedBy defaults. On GCP, keys and values must be lowercase letters, digits, underscores or dashes."
  type        = map(string)
  default     = {}
}

variable "database_password" {
  description = "Master password for the RDS PostgreSQL instance (generated by the root module)."
  type        = string
  sensitive   = true
}

variable "redis_password" {
  description = "AUTH token for the ElastiCache Redis replication group, 16-128 chars (generated by the root module)."
  type        = string
  sensitive   = true
}

variable "rds_engine_version" {
  description = "PostgreSQL major (or full) version for RDS."
  type        = string
  default     = "16"
}

variable "rds_instance_class" {
  description = "RDS instance class (Graviton: db.t4g.*, db.m7g.*)."
  type        = string
  default     = "db.t4g.small"
}

variable "rds_allocated_storage" {
  description = "Initial RDS storage in GiB."
  type        = number
  default     = 20
}

variable "rds_max_allocated_storage" {
  description = "RDS storage autoscaling ceiling in GiB (0 disables autoscaling)."
  type        = number
  default     = 0
}

variable "rds_multi_az" {
  description = "Run RDS as a Multi-AZ deployment."
  type        = bool
  default     = false
}

variable "rds_backup_retention_days" {
  description = "Days to keep automated RDS backups (0 disables backups)."
  type        = number
  default     = 1
}

variable "rds_deletion_protection" {
  description = "Enable RDS deletion protection."
  type        = bool
  default     = false
}

variable "elasticache_node_type" {
  description = "ElastiCache node type (Graviton: cache.t4g.*, cache.m7g.*)."
  type        = string
  default     = "cache.t4g.micro"
}

variable "elasticache_engine_version" {
  description = "ElastiCache Redis engine version."
  type        = string
  default     = "7.1"
}

variable "s3_force_destroy" {
  description = "Allow terraform destroy to delete the Active Storage S3 bucket even when it contains objects."
  type        = bool
  default     = false
}

variable "enable_cloudwatch_logs" {
  description = "Send EKS control plane logs, RDS PostgreSQL logs and pod logs (Fluent Bit) to CloudWatch Logs."
  type        = bool
  default     = true
}

variable "cloudwatch_log_retention_days" {
  description = "Retention in days for the CloudWatch log groups created by this module."
  type        = number
  default     = 30
}

variable "name_prefix" {
  description = "Chart naming prefix <app>-<environment> (e.g. fabricate-prod), used for the app service account and the NodePool."
  type        = string
  default     = "fabricate-prod"
}
